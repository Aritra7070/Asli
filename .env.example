# Asli — demo signer keys.
#
# These are THROWAWAY wallets on the Arkiv Tiramisu TESTNET used to sign the
# synthetic demo data below. They hold no real value. Keys are written to
# .env.local (git-ignored) by `npm run wallets:new` — never commit them.
#
# Roles:
#   MFR      Aushadh Labs (synthetic manufacturer) — batch attestations, recalls
#   DIST     MedRoute Logistics (synthetic distributor) — custody hops
#   RELIANT  Reliant Pharmacy, Pune — custody + registry
#   QM       QuickMeds Hub, Gurugram — quick-commerce dark store custody
#   RELAY    Asli Scan Relay — signs anonymous public patient scans (city-level only)
#   FAKE     Unregistered seller — demo counterfeiter (same batch code, wrong signer)

ASLI_MFR_PRIVATE_KEY=
ASLI_DIST_PRIVATE_KEY=
ASLI_RELIANT_PRIVATE_KEY=
ASLI_QM_PRIVATE_KEY=
ASLI_RELAY_PRIVATE_KEY=
ASLI_FAKE_PRIVATE_KEY=

# Optional: the wallet you fund from (e.g. your MetaMask burner) used ONLY by
# `npm run wallets:fund` to distribute testnet GLM to the demo signers above.
# Paste it directly into .env.local on your own machine. Never in chat, code or git.
FUNDER_PRIVATE_KEY=

# Optional but recommended: an Arkiv access key for the shared RPC. Without
# one, the anonymous query budget can run out under load (it did on submission
# day — see arkiv/friction.md #15) and reads fall back to cached copies.
# One key per wallet per network; create one at https://hub.arkiv.network/api-keys
# (select Tiramisu). Both lines take the same key value: the server sends its
# copy as an X-API-KEY header; the NEXT_PUBLIC_ copy goes in the URL path from
# the browser, because a browser WebSocket cannot set custom headers. It is a
# revocable quota key, not a signing key.
ARKIV_ACCESS_KEY=
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
